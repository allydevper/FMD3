{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FMD3",
  "version": "0.1.0",
  "identifier": "com.wilmer.fmd3",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "FMD3",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/FMD3/covers/**", "$APPDATA/**/FMD3/covers/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlEQkM1QjE4QUYyQUQyRjkKUldUNTBpcXZHRnU4bmNnOGhjK0JxdHNVZncreHZvamsyMTQxV1JCd0o4Z3ZpY0ZpQUx1a2t0WW0K",
      "endpoints": [
        "https://github.com/allydevper/FMD3/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
